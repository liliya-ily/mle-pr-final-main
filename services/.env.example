# Скопируйте в .env и заполните значения: cp services/.env.example services/.env
# Файл .env в репозиторий не попадает (указан в .gitignore).

# S3-совместимое хранилище: артефакты MLflow и файлы для сервиса
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_DEFAULT_REGION=ru-central1
AWS_ACCESS_KEY_ID=<ключ доступа>
AWS_SECRET_ACCESS_KEY=<секретный ключ>
BUCKET=<имя бакета>

# PostgreSQL: backend store и Model Registry MLflow
DB_DESTINATION_HOST=<хост>
DB_DESTINATION_PORT=<порт>
DB_DESTINATION_NAME=<имя базы>
DB_DESTINATION_USER=<пользователь>
DB_DESTINATION_PASSWORD=<пароль>

# Порт сервиса внутри контейнера
APP_PORT=8081
