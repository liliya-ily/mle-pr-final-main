# Необязательные переменные окружения. Для запуска значения по умолчанию подходят,
# при необходимости скопируйте файл: cp services/.env.example services/.env

# Адрес MLflow Tracking Server для ноутбуков
MLFLOW_TRACKING_URI=http://localhost:5000

# Папка с исходным файлом train_ver2.csv (по умолчанию data/)
# DATA_DIR=data

# Учётные данные Grafana в docker-compose (по умолчанию admin / admin)
# GRAFANA_USER=admin
# GRAFANA_PASS=admin
