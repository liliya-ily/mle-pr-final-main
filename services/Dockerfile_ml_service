FROM python:3.10-slim

# Порт сервиса внутри контейнера (можно переопределить переменной окружения)
ENV APP_PORT=8081 \
    PYTHONUNBUFFERED=1

# libgomp1 нужна CatBoost
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Код микросервиса; модель (models) и таблицы (assets) подключаются томами в docker-compose.yaml
COPY ml_service ./services/ml_service

EXPOSE ${APP_PORT}

CMD uvicorn services.ml_service.main_monitoring:app --host 0.0.0.0 --port ${APP_PORT}
