# Базовый образ
FROM python:3.10-slim

# Значения по умолчанию (могут быть переопределены через --env-file)
ENV APP_PORT=8081
ENV AUTHOR="mle-student"

LABEL author=${AUTHOR}

# Рабочая директория внутри контейнера
WORKDIR /app

# Копируем requirements
COPY requirements.txt ./requirements.txt

# Устанавливаем зависимости
RUN pip install --no-cache-dir -r requirements.txt

# Копируем код микросервиса и модель
COPY ml_service ./services/ml_service
# COPY models ./services/models
# COPY assets ./services/assets

# Документируем внутренний порт
EXPOSE ${APP_PORT}

# Команда запуска FastAPI приложения
CMD uvicorn services.ml_service.main_monitoring:app --host 0.0.0.0 --port ${APP_PORT}